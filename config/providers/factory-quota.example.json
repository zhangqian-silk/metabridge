{
  "name": "factory",
  "base_url": "https://api.factory.ai",
  "auth": {
    "type": "keyfile",
    "file": "./factory-api-key"
  },
  "gateway": {
    "instruction_mode": "factory_prefix",
    "client_version": "0.162.1",
    "host": "127.0.0.1",
    "port": 8319,
    "attachment_optimization": {
      "enabled": true,
      "maxDimension": 1568,
      "maxImageBytes": 512000,
      "requestTargetBytes": 4000000,
      "jpegQuality": 80
    },
    "models": [
      { "id": "gpt-6.1-sol", "protocol": "responses", "provider": "openai" },
      { "id": "claude-sonnet-5-5", "protocol": "messages", "provider": "anthropic" },
      { "id": "claude-haiku-4-5-20251001", "protocol": "messages", "provider": "anthropic" },
      { "id": "glm-5.3", "protocol": "chat", "provider": "fireworks" }
    ]
  },
  "quota": {
    "billingLimits": true,
    "globalLimit": true,
    "userLimits": true,
    "personalUsage": true,
    "usage": {}
  }
}
